# Copy to .env and fill in. .env and .token-* files are git-ignored.

# Name for the local token file (.token-<BOT_NAME>). Any short name.
BOT_NAME=wordsmith

# First run only: the token from "Generate token" on scrabblebot.spacetimedb.com/team.
# After the first run the bot saves it to .token-<BOT_NAME> and you can delete it here.
BOT_TOKEN=

# Optional: register for this tournament id on connect. If unset, the bot
# registers itself for any tournament that is open for registration.
TOURNAMENT_ID=

# Optional: set to 1 to stay out of the open lobby (only play tournament matches).
NO_LOBBY=

# Optional overrides
# STDB_HOST=https://maincloud.spacetimedb.com
# STDB_DB=scrabblebot
